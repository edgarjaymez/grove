{
	"name": "@edgarjaymez/grove",
	"version": "0.23.0-beta.1",
	"description": "Grove Design System — Where living systems take root.",
	"license": "MIT",
	"author": {
		"name": "Edgar Diaz",
		"url": "https://github.com/edgarjaymez"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/edgarjaymez/grove.git"
	},
	"homepage": "https://grove-ds.vercel.app",
	"bugs": {
		"url": "https://github.com/edgarjaymez/grove/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepack": "pnpm build-tokens && vite build && publint",
		"check": "tsc --noEmit",
		"check:watch": "tsc --noEmit --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"build-tokens": "tz build"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./tokens.css": "./dist/tokens/tokens.css",
		"./fonts/*": "./dist/fonts/*",
		"./fonts.css": "./dist/fonts/fonts.css"
	},
	"peerDependencies": {
		"lit": "^3.0.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "5.2.1",
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.60.0",
		"@storybook/addon-a11y": "10.4.1",
		"@storybook/addon-docs": "10.4.1",
		"@storybook/addon-vitest": "10.4.1",
		"@storybook/web-components": "10.4.1",
		"@storybook/web-components-vite": "10.4.1",
		"@terrazzo/cli": "2.2.0",
		"@terrazzo/plugin-css": "2.2.0",
		"@types/node": "25.9.1",
		"@vitest/coverage-v8": "4.1.7",
		"eslint": "10.4.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-storybook": "10.4.1",
		"eslint-plugin-lit": "2.3.1",
		"eslint-plugin-lit-a11y": "5.1.1",
		"globals": "17.6.0",
		"lit": "3.3.3",
		"playwright": "1.60.0",
		"prettier": "3.8.3",
		"publint": "0.3.21",
		"storybook": "10.4.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.60.0",
		"vite": "8.0.14",
		"unplugin-dts": "1.0.1",
		"vite-plugin-static-copy": "4.1.0",
		"vitest": "4.1.7"
	},
	"keywords": [
		"lit",
		"design-system",
		"design-tokens",
		"components",
		"web-components",
		"ui",
		"grove"
	],
	"dependencies": {},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
